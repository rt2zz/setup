# Personal zsh modifications
# Sourced from .zshrc after plugins are loaded

# --- Profiling ---
# Startup time per function, for everything sourced after .zshrc_base's zmodload.
zsh_profile() {
  ZPROF=1 zsh -i -c zprof
}

# --- Keybindings ---
bindkey '^[^M' autosuggest-execute
bindkey '^[[3~' delete-char

# claude in yolo mode
clawd () {
  # Don't inject YOLO flag for subcommands where it may not be accepted/desired.
  case "$1" in
    update|mcp|-v|--version|help|--help)
      command claude "$@"
      ;;
    *)
      command claude --dangerously-skip-permissions "$@"
      ;;
  esac
}

# codex in full-auto mode
alias clawdex='codex --full-auto'

# --- Prompt and tab title ---
#   ⚡ ｢devSubDir·workspace｣ cwdName description
#       ➜
# The description is the jj change's first line, or the git branch. Outside
# ~/dev, the current directory name replaces the ｢…｣ label. Inside it, the tab
# title gets the label and description. One jj call per prompt.
autoload -Uz add-zsh-hook

_prompt_precmd() {
  local info ws desc sub label where

  # jj first: colocated repos also have .git.
  if info=$(jj log --ignore-working-copy -n 1 --no-graph --color never -r @ \
      -T 'working_copies.map(|w| w.name()).join("+") ++ "\t" ++ description.first_line().substr(0, 30)' 2>/dev/null); then
    ws="${info%%$'\t'*}"
    desc="${info#*$'\t'}"
  else
    desc=$(git symbolic-ref --short HEAD 2>/dev/null)
  fi

  if [[ "$PWD" == "$HOME/dev" ]]; then
    label="｢dev｣"
  elif [[ "$PWD" == "$HOME/dev/"* ]]; then
    sub="${${PWD#$HOME/dev/}%%/*}"
    label="$sub"
    [[ -n "$ws" && "$ws" != default ]] && label+="·$ws"
    label="｢$label｣"
  fi

  if [[ -n "$label" ]]; then
    print -rn -- $'\e]2;'"$label${desc:+ $desc}"$'\a'
    where="%F{magenta}${label//\%/%%}%f"
    [[ -n "$sub" && "${PWD##*/}" != "$sub" ]] && where+=" %F{cyan}${${PWD##*/}//\%/%%}%f"
  else
    where="%F{cyan}%c%f"
  fi
  [[ -n "$desc" ]] && where+=" %F{245}${desc//\%/%%}%f"

  # Input goes on its own line, after an arrow that turns red on failure.
  PROMPT="%B%F{yellow}⚡%f%b $where"$'\n'"    %(?.%F{green}.%F{red})➜%f "
}
add-zsh-hook precmd _prompt_precmd

# Shortened jj status - shows first 10 lines with "... more" hint if truncated
jj-short-status() {
  local -a lines=("${(@f)$(jj --no-pager status --color=always)}")
  print -rl -- "${(@)lines[1,10]}"
  (( ${#lines} > 10 )) && echo "... more"
}

# Magic enter commands for different repo types
MAGIC_ENTER_JJ_COMMAND='jj-short-status'
MAGIC_ENTER_GIT_COMMAND='git status -u .'
MAGIC_ENTER_OTHER_COMMAND='ls -lh .'

# jj-aware magic-enter (checks jj first, then git, then fallback)
# Runs configured command when pressing Enter on empty command line
magic-enter() {
  if [[ -n "$BUFFER" || "$CONTEXT" != start ]]; then
    return
  fi

  if jj root &>/dev/null; then
    BUFFER="$MAGIC_ENTER_JJ_COMMAND"
  elif command git rev-parse --is-inside-work-tree &>/dev/null; then
    BUFFER="$MAGIC_ENTER_GIT_COMMAND"
  else
    BUFFER="$MAGIC_ENTER_OTHER_COMMAND"
  fi
}

# Wire up magic-enter to the accept-line widget (Enter key)
_magic-enter-accept-line() {
  magic-enter
  zle .accept-line
}
zle -N accept-line _magic-enter-accept-line

# jj shortcuts
jd() { jj describe -m "$*"; }
jn() { jj new -m "$*"; }
jb() { jj bookmark move "$1" --to @; }
jp() {
  local change="${1:-@}"
  local bookmark="$2"
  shift 2 2>/dev/null || shift $#
  if [ -n "$bookmark" ]; then
    jj bookmark set "$bookmark" -r "$change" "$@"
    jj git push --bookmark "$bookmark"
  else
    jj git push -c "$change" "$@"
  fi
}
jr() { jj git fetch && jj rebase -d "${1:-main}@origin"; }

# j <query>: cd to the single zoxide match, or pick from several (or none) with
# zoxide's interactive picker (needs fzf).
j() {
  if [ $# -eq 0 ]; then
    echo "usage: j <query>" >&2
    return 2
  fi

  local -a matches=("${(@f)$(zoxide query -l -- "$@")}")
  local dest
  if (( ${#matches} == 1 )) && [[ -n "${matches[1]}" ]]; then
    dest="${matches[1]}"
  else
    dest="$(zoxide query --interactive -- "$@")" || return
  fi

  # Empty when the picker is cancelled.
  [[ -n "$dest" ]] || return 0
  printf '→ %s\n' "$dest"
  cd -- "$dest"
}
