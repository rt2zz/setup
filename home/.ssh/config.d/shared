# Shared SSH config, synced from the setup repo (home/.ssh/config.d/shared).
# Machine-specific entries belong in ~/.ssh/config above the Include line;
# ssh uses the first value it finds per option, so those override these.

Host fox
  HostName fox
  User eleven
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
